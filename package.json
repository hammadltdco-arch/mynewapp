{
  "name": "loop-messenger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:security && npm run test:ui",
    "test:security": "node --test backend-tests/*.test.mjs",
    "test:ui": "playwright test",
    "legal:build": "node scripts/legal.mjs",
    "assets:build": "node scripts/assets.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && python scripts/gradle.py :app:assembleDebug",
    "release:check": "node scripts/release-check.mjs",
    "android:release": "npm run release:check && npm test && npm run android:sync && python scripts/gradle.py :app:lintRelease :app:bundleRelease",
    "android:demo": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "latest"
  }
}
